### 1. Test Case Tốt (Mọi thứ suôn sẻ) - Mong đợi 200 OK
POST {{host}}/api/v1/auth/guest
Content-Type: application/json

{
  "nickname": "GiaKietVipPro"
}

> {%
    client.test("API returns successful 200 OK", function() {
        client.assert(response.status === 200, "Error: status code is not 200, check database connection!");
    });
    client.test("Check DTO response format", function() {
        client.assert(response.body.hasOwnProperty("userId"), "Missing UserId in JSON response");
        client.assert(response.body.nickname === "GiaKietVipPro", "Server stored incorrect nickname!");
    });
%}

### 2. Test Case Sai (Cố tình chèn Nickname rỗng) - Mong đợi 400 Bad Request
POST {{host}}/api/v1/auth/guest
Content-Type: application/json

{
  "nickname": "    "
}

> {%
    client.test("Server blocks with 400 Bad Request", function() {
        client.assert(response.status === 400, "Should have failed due to empty payload!");
    });
%}

### 3. Test Case Sai (Đéo xì Data Nickname ra luôn) - Mong đợi 400 Bad Request
POST {{host}}/api/v1/auth/guest
Content-Type: application/json

{}

> {%
    client.test("Server blocks missing body", function() {
        client.assert(response.status === 400, "Should have failed: Null nickname is not allowed!");
    });
%}
