### 1. Test Case Tốt (Mọi thứ suôn sẻ) - Mong đợi 200 OK
POST {{host}}/api/v1/auth/guest
Content-Type: application/json

{
  "nickname": "GiaKietVipPro"
}

> {%
    client.test("API trả về thành công 200 OK", function() {
        client.assert(response.status === 200, "Lỗi cmnr, mã trả về không phải 200, coi chừng sập DB!");
    });
    client.test("Kiểm tra nội dung DTO trả về đúng chuẩn", function() {
        client.assert(response.body.hasOwnProperty("userId"), "Thiếu mất cột UserId trong JSON trả về");
        client.assert(response.body.nickname === "GiaKietVipPro", "Server lưu sai Nickname của tao rồi!");
    });
%}

### 2. Test Case Sai (Cố tình chèn Nickname rỗng) - Mong đợi 400 Bad Request
POST {{host}}/api/v1/auth/guest
Content-Type: application/json

{
  "nickname": "    "
}

> {%
    client.test("Server chặn cửa báo 400 Bad Request kịp thời", function() {
        client.assert(response.status === 400, "Khoan đã, tao truyền rỗng mà mày vẫn cho vào là mày ngu rồi server ơi!");
    });
%}

### 3. Test Case Sai (Đéo xì Data Nickname ra luôn) - Mong đợi 400 Bad Request
POST {{host}}/api/v1/auth/guest
Content-Type: application/json

{}

> {%
    client.test("Server chặn chát chúa vì thiếu Body", function() {
        client.assert(response.status === 400, "Chết rồi thằng server, mài định cho nó xài Nickname NULL à?");
    });
%}
