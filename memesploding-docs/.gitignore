# Ignore everything in .obsidian
.obsidian/*

# BUT keep important config files
!.obsidian/app.json
!.obsidian/appearance.json
!.obsidian/core-plugins.json
!.obsidian/community-plugins.json
!.obsidian/plugins/
!.obsidian/snippets/

# Ignore volatile workspace/state files (these change constantly)
.obsidian/workspace.json
.obsidian/workspaces.json
.obsidian/cache